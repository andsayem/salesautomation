<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/row_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Fixed Columns -->
        <TextView
            android:id="@+id/txt_product"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="12sp"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/txt_sap"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="12sp"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/txt_req_qty"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="12sp"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/txt_req_value"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="12sp"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/txt_billing_qty"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="12sp"
            android:textColor="#000000"/>

        <TextView
            android:id="@+id/txt_billing_value"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="12sp"
            android:textColor="#000000"/>

        <!-- Dynamic Reason Columns Container -->
        <LinearLayout
            android:id="@+id/reason_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>
</HorizontalScrollView>