<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="4dp">

        <TextView
            android:id="@+id/txt_sl"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cell_border"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txt_point_name"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cell_border"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txt_sap_code"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cell_border"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txt_pg_name"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cell_border"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txt_product_code"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cell_border"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txt_product_name"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cell_border"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txt_target_qty"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cell_border"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txt_target_value"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cell_border"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txt_req_qty"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cell_border"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txt_req_value"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cell_border"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txt_billed_qty"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cell_border"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txt_billed_value"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:background="@drawable/cell_border"
            android:textSize="12sp"/>

        <!-- Dynamic Reason Container -->
        <LinearLayout
            android:id="@+id/reason_container"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</HorizontalScrollView>